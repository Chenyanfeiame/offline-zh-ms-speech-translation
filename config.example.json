{
  "offline": true,
  "device": "auto",
  "models_dir": "models",
  "outputs_dir": "outputs",
  "asr_backend": "qwen-context",
  "asr_ms_backend": "qwen-context",
  "asr_qwen_model": "models/qwen3-asr-1.7b-4bit",
  "lid_model": "models/lid-voxlingua107-coreml",
  "asr_num_beams": 1,
  "asr_ms_num_beams": 1,
  "asr_preprocess_audio": true,
  "baseline_direct_pipeline": true,
  "entity_enhancement_enabled": false,
  "entity_prompt_enabled": false,
  "entity_lexicon": "data/entity_lexicon.json",
  "selective_entity_rescue_enabled": true,
  "selective_entity_rescue_max_candidates": 3,
  "selective_entity_rescue_max_prompt_characters": 96,
  "mt_backend": "hy-mt-llama",
  "mt_hy_model": "models/hy-mt1.5-1.8b-q4/HY-MT1.5-1.8B-Q4_K_M.gguf",
  "mt_llama_server_path": "/opt/homebrew/bin/llama-server",
  "mt_hy_port": 18081,
  "mt_hy_gpu_layers": 99,
  "mt_terminology_enabled": false,
  "mt_critical_slot_protection_enabled": false,
  "tts_backend": "piper-mms",
  "tts_piper_model": "models/piper/zh_CN-huayan-medium/zh_CN-huayan-medium.onnx",
  "tts_piper_config": "models/piper/zh_CN-huayan-medium/zh_CN-huayan-medium.onnx.json",
  "tts_piper_alt_model": "models/piper/zh_CN-xiao_ya-medium/zh_CN-xiao_ya-medium.onnx",
  "tts_piper_alt_config": "models/piper/zh_CN-xiao_ya-medium/zh_CN-xiao_ya-medium.onnx.json",
  "tts_default_zh_voice": "xiao_ya",
  "tts_piper_data_dir": "models/piper/resources",
  "tts_piper_tokenizer_dir": "models/piper/resources/bert-base-chinese",
  "tts_mms_model": "models/mms-tts-zlm",
  "tts_voices": {"zh": "Tingting", "ms": "Amira"},
  "max_upload_mb": 25,
  "max_audio_seconds": 300,
  "keep_intermediate": true
}
